# ---- Logging ----
LOG_LEVEL=INFO

# ---- NLP (local sentence-transformer) ----
NLP_MODEL=all-MiniLM-L6-v2
SIMILARITY_THRESHOLD=0.7

# ---- Resume parser ----
MAX_FILE_SIZE_MB=10

# ---- Google Gemini API ----
# Get a key from https://aistudio.google.com/app/apikey
# The app still runs without a valid key (parsing falls back to offline regex,
# AI enhancement/feedback are skipped), but AI features need a valid key.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Set to "false" to disable all AI calls (fully offline mode)
ENABLE_AI=true
